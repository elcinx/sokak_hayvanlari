<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>

    <body class="pet-theme" data-is-auth="<%= fullname ? 'true' : 'false' %>">
        <%- include('../partials/navbar') %>

            <main class="container py-4">
                                                <section class="hero hero-card hero-showcase mb-4">
                    <div class="hero-content">
                        <div class="hero-text">
                            <div class="hero-eyebrow mb-2">Sokak Hayvanlari Platformu</div>
                            <h1 class="hero-title mb-3">Onlar Icin Bir Kap Sevgi Dolu!</h1>
                            <div class="hero-subtitle-pill mb-4">
                                Sokak dostlarimiza birlikte ulasalim
                            </div>
                            <div class="d-flex flex-wrap gap-3 hero-actions">
                                <a href="#mapSection" class="btn btn-main btn-lg" id="heroLocateBtn">Konumumu Bul</a>
                                <button class="btn btn-soft btn-lg" id="openFeedForm" type="button">+ Besleme Ekle</button>
                            </div>
                            <div class="hero-badge mt-4">Topluluk projesi &#x1F43E;</div>
                        </div>
                        <div class="hero-visual" aria-hidden="true">
                            <div class="hero-gradient"></div>
                            <div class="hero-wave">
                                <svg width="100%" height="100%" viewBox="0 0 1440 320" preserveAspectRatio="none">
                                    <path fill="#ffffff" opacity="0.25" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,138.7C960,139,1056,117,1152,117.3C1248,117,1344,139,1392,149.3L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z" />
                                </svg>
                            </div>
                            <div class="hero-spark hero-spark-1">
                                <svg width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="25" fill="#FFD700" opacity="0.6" /><circle cx="30" cy="30" r="20" fill="#FFF" opacity="0.3" /></svg>
                            </div>
                            <div class="hero-spark hero-spark-2">
                                <svg width="50" height="50" viewBox="0 0 50 50"><path d="M 25 10 L 28 20 L 38 20 L 30 26 L 33 36 L 25 30 L 17 36 L 20 26 L 12 20 L 22 20 Z" fill="#FFF" opacity="0.7" /></svg>
                            </div>
                            <div class="hero-spark hero-spark-3">
                                <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="3" fill="#fff" /><circle cx="12" cy="10" r="4" fill="#fff" /><circle cx="28" cy="10" r="4" fill="#fff" /><circle cx="8" cy="25" r="4" fill="#fff" /><circle cx="32" cy="25" r="4" fill="#fff" /><ellipse cx="20" cy="30" rx="8" ry="5" fill="#fff" /></svg>
                            </div>
                            <div class="hero-characters">
                                <div class="hero-cat">
                                    <svg width="200" height="220" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg"><ellipse cx="100" cy="210" rx="45" ry="8" fill="#000" opacity="0.2" /><ellipse cx="100" cy="140" rx="50" ry="60" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><circle cx="100" cy="70" r="45" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><path d="M 70 40 L 60 10 L 85 35" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><path d="M 70 38 L 65 20 L 82 36" fill="#FFB366" /><path d="M 130 40 L 140 10 L 115 35" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><path d="M 130 38 L 135 20 L 118 36" fill="#FFB366" /><ellipse cx="100" cy="80" rx="35" ry="30" fill="#FFF" opacity="0.3" /><ellipse cx="85" cy="68" rx="10" ry="14" fill="#2D3748" /><circle cx="87" cy="65" r="5" fill="#FFF" /><circle cx="89" cy="70" r="2" fill="#FFF" opacity="0.8" /><ellipse cx="115" cy="68" rx="10" ry="14" fill="#2D3748" /><circle cx="117" cy="65" r="5" fill="#FFF" /><circle cx="119" cy="70" r="2" fill="#FFF" opacity="0.8" /><path d="M 100 80 L 96 86 L 104 86 Z" fill="#E91E63" /><path d="M 100 86 Q 90 95 82 90" stroke="#2D3748" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M 100 86 Q 110 95 118 90" stroke="#2D3748" stroke-width="3" fill="none" stroke-linecap="round" /><line x1="55" y1="72" x2="25" y2="68" stroke="#2D3748" stroke-width="2" stroke-linecap="round" /><line x1="55" y1="80" x2="25" y2="84" stroke="#2D3748" stroke-width="2" stroke-linecap="round" /><line x1="145" y1="72" x2="175" y2="68" stroke="#2D3748" stroke-width="2" stroke-linecap="round" /><line x1="145" y1="80" x2="175" y2="84" stroke="#2D3748" stroke-width="2" stroke-linecap="round" /><circle cx="70" cy="78" r="12" fill="#FF8C00" opacity="0.4" /><circle cx="130" cy="78" r="12" fill="#FF8C00" opacity="0.4" /><ellipse cx="80" cy="195" rx="16" ry="20" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><ellipse cx="120" cy="195" rx="16" ry="20" fill="#FF8C42" stroke="#2D3748" stroke-width="3" /><ellipse cx="80" cy="198" rx="8" ry="6" fill="#FFB366" /><ellipse cx="120" cy="198" rx="8" ry="6" fill="#FFB366" /><path d="M 50 150 Q 20 140 25 110" stroke="#FF8C42" stroke-width="24" fill="none" stroke-linecap="round" /><path d="M 50 150 Q 20 140 25 110" stroke="#2D3748" stroke-width="3" fill="none" stroke-linecap="round" /></svg>
                                </div>
                                <div class="hero-dog">
                                    <svg width="220" height="220" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg"><ellipse cx="110" cy="210" rx="50" ry="8" fill="#000" opacity="0.2" /><path d="M 165 140 Q 200 125 195 95" stroke="#8B4513" stroke-width="32" fill="none" stroke-linecap="round" /><path d="M 165 140 Q 200 125 195 95" stroke="#2D3748" stroke-width="3" fill="none" stroke-linecap="round" /><ellipse cx="195" cy="95" rx="12" ry="18" fill="#A0522D" opacity="0.6" transform="rotate(25 195 95)" /><ellipse cx="110" cy="140" rx="56" ry="62" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><ellipse cx="85" cy="150" rx="18" ry="22" fill="#A0522D" opacity="0.4" /><circle cx="130" cy="135" r="15" fill="#A0522D" opacity="0.3" /><ellipse cx="110" cy="75" rx="50" ry="52" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><path d="M 75 50 Q 65 55 62 70 Q 60 85 65 100 Q 68 110 75 105 Q 78 95 80 80 Q 82 65 78 52 Z" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><path d="M 75 55 Q 68 60 66 72 Q 65 85 68 95 Q 70 100 74 98 Q 76 88 77 78 Q 78 68 76 58 Z" fill="#A0522D" /><path d="M 145 50 Q 155 55 158 70 Q 160 85 155 100 Q 152 110 145 105 Q 142 95 140 80 Q 138 65 142 52 Z" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><path d="M 145 55 Q 152 60 154 72 Q 155 85 152 95 Q 150 100 146 98 Q 144 88 143 78 Q 142 68 144 58 Z" fill="#A0522D" /><circle cx="135" cy="48" r="14" fill="#8B4513" opacity="0.5" stroke="#2D3748" stroke-width="2" /><circle cx="128" cy="52" r="10" fill="#8B4513" opacity="0.4" stroke="#2D3748" stroke-width="2" /><ellipse cx="110" cy="92" rx="32" ry="28" fill="#FFE4C4" stroke="#2D3748" stroke-width="3" /><ellipse cx="110" cy="88" rx="28" ry="20" fill="#FFF5E6" opacity="0.5" /><ellipse cx="92" cy="70" rx="13" ry="17" fill="#2D3748" /><circle cx="95" cy="66" r="6" fill="#FFF" /><circle cx="98" cy="71" r="3" fill="#FFF" opacity="0.8" /><circle cx="90" cy="68" r="2" fill="#FFF" /><ellipse cx="128" cy="70" rx="13" ry="17" fill="#2D3748" /><circle cx="131" cy="66" r="6" fill="#FFF" /><circle cx="134" cy="71" r="3" fill="#FFF" opacity="0.8" /><circle cx="126" cy="68" r="2" fill="#FFF" /><ellipse cx="110" cy="90" rx="9" ry="7" fill="#2D3748" /><circle cx="107" cy="88" r="3" fill="#FFF" opacity="0.7" /><ellipse cx="112" cy="91" rx="2" ry="1" fill="#FFF" opacity="0.5" /><path d="M 95 100 Q 110 108 125 100" stroke="#2D3748" stroke-width="3" fill="none" stroke-linecap="round" /><ellipse cx="110" cy="105" rx="6" ry="4" fill="#FF6B9D" stroke="#2D3748" stroke-width="2" /><circle cx="88" cy="84" r="1.5" fill="#8B4513" opacity="0.6" /><circle cx="92" cy="88" r="1.5" fill="#8B4513" opacity="0.6" /><circle cx="128" cy="84" r="1.5" fill="#8B4513" opacity="0.6" /><circle cx="132" cy="88" r="1.5" fill="#8B4513" opacity="0.6" /><ellipse cx="68" cy="86" rx="16" ry="13" fill="#FF8C42" opacity="0.5" /><ellipse cx="152" cy="86" rx="16" ry="13" fill="#FF8C42" opacity="0.5" /><path d="M 82 58 Q 88 55 94 56" stroke="#8B4513" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6" /><path d="M 126 56 Q 132 55 138 58" stroke="#8B4513" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6" /><rect x="83" y="190" width="22" height="26" rx="11" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><rect x="115" y="190" width="22" height="26" rx="11" fill="#8B4513" stroke="#2D3748" stroke-width="3" /><ellipse cx="94" cy="203" rx="8" ry="6" fill="#A0522D" /><circle cx="89" cy="196" r="3" fill="#A0522D" /><circle cx="94" cy="195" r="3" fill="#A0522D" /><circle cx="99" cy="196" r="3" fill="#A0522D" /><ellipse cx="126" cy="203" rx="8" ry="6" fill="#A0522D" /><circle cx="121" cy="196" r="3" fill="#A0522D" /><circle cx="126" cy="195" r="3" fill="#A0522D" /><circle cx="131" cy="196" r="3" fill="#A0522D" /><ellipse cx="110" cy="122" rx="32" ry="8" fill="#FF6B6B" stroke="#2D3748" stroke-width="2" /><path d="M 110 130 L 105 142 L 115 142 Z" fill="#FFD700" stroke="#2D3748" stroke-width="2" /><circle cx="110" cy="135" r="3" fill="#2D3748" /></svg>
                                </div>
                                <div class="hero-bowls">
                                    <svg width="350" height="160" viewBox="0 0 350 160" fill="none" xmlns="http://www.w3.org/2000/svg"><g transform="translate(80, 85)"><ellipse cx="0" cy="35" rx="48" ry="10" fill="#000" opacity="0.15" /><path d="M -45 0 L -38 32 Q 0 42 38 32 L 45 0 Z" fill="#4FD1C5" stroke="#2D3748" stroke-width="3" /><ellipse cx="0" cy="0" rx="45" ry="10" fill="#81E6D9" stroke="#2D3748" stroke-width="2" /><circle cx="-15" cy="12" r="7" fill="#FFD700" stroke="#2D3748" stroke-width="2" /><circle cx="8" cy="14" r="6" fill="#8B4513" stroke="#2D3748" stroke-width="2" /><circle cx="-6" cy="16" r="5" fill="#FFD700" stroke="#2D3748" stroke-width="2" /><circle cx="16" cy="12" r="6" fill="#8B4513" stroke="#2D3748" stroke-width="2" /><ellipse cx="0" cy="10" rx="4" ry="5" fill="#FF8C42" stroke="#2D3748" stroke-width="2" /></g><g transform="translate(270, 85)"><ellipse cx="0" cy="35" rx="48" ry="10" fill="#000" opacity="0.15" /><path d="M -45 0 L -38 32 Q 0 42 38 32 L 45 0 Z" fill="#4FD1C5" stroke="#2D3748" stroke-width="3" /><ellipse cx="0" cy="0" rx="45" ry="10" fill="#81E6D9" stroke="#2D3748" stroke-width="2" /><ellipse cx="0" cy="14" rx="38" ry="14" fill="#63B3ED" opacity="0.7" /><ellipse cx="-10" cy="10" rx="12" ry="6" fill="#FFF" opacity="0.6" /><circle cx="15" cy="14" r="5" fill="#FFF" opacity="0.4" /></g><g transform="translate(30, 50)" opacity="0.4"><ellipse cx="0" cy="0" rx="8" ry="10" fill="#2D3748" /><circle cx="-7" cy="-8" r="4" fill="#2D3748" /><circle cx="0" cy="-10" r="4" fill="#2D3748" /><circle cx="7" cy="-8" r="4" fill="#2D3748" /></g><g transform="translate(320, 60)" opacity="0.4"><ellipse cx="0" cy="0" rx="8" ry="10" fill="#2D3748" /><circle cx="-7" cy="-8" r="4" fill="#2D3748" /><circle cx="0" cy="-10" r="4" fill="#2D3748" /><circle cx="7" cy="-8" r="4" fill="#2D3748" /></g></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="about" class="section-card p-4 mb-4 about-card">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h2 class="section-title mb-2">Hakkinda</h2>
                            <p class="section-subtitle mb-0">Biz bu toplulukta sokak hayvanlarini beslemek icin
                                buradayiz. Siz de katilin, birlikte daha cok cana dokunalim. 💛</p>
                        </div>
                    </div>
                </section>

                            <section class="row g-4 mb-4 stats-row dashboard-row">
                <div class="col-12 col-md-4">
                    <div class="dashboard-card h-100">
                        <div class="dashboard-icon"><span>??</span></div>
                        <div class="dashboard-value" id="activePoints"><%= summary.activePoints %></div>
                        <div class="dashboard-label">Aktif Nokta</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="dashboard-card h-100">
                        <div class="dashboard-icon"><span>??</span></div>
                        <div class="dashboard-value" id="onlineUsers">-</div>
                        <div class="dashboard-label">Online Kullanici</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="dashboard-card h-100">
                        <div class="dashboard-icon"><span>??</span></div>
                        <div class="dashboard-value" id="todayVisits"><%= summary.todayVisits || '-' %></div>
                        <div class="dashboard-label">Bugunku Ziyaretci</div>
                    </div>
                </div>
            </section>

                <section class="row g-4">
                    <div class="col-lg-8">
                        <div class="section-card p-3 p-lg-4 map-card" id="mapSection">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 map-header">
                                <div>
                                    <h3 class="section-title mb-1">Harita & Noktalar</h3>
                                    <p class="section-subtitle mb-0">Konumuna en yakin besleme noktalarini harita
                                        uzerinden kesfet.</p>
                                </div>
                                <div class="map-toolbar d-flex flex-wrap gap-2 mt-2 mt-lg-0">
                                    <button class="btn btn-main btn-sm" id="locateBtn">Konumumu Bul</button>
                                    <button class="btn btn-soft btn-sm" id="toggleHeatmap">Heatmap</button>
                                    <div class="d-flex flex-wrap gap-2">
                                        <div class="chip-filter">
                                            <input type="checkbox" id="filterCritical" class="filter-status"
                                                value="critical" checked>
                                            <label for="filterCritical" class="filter-chip">Kritik</label>
                                        </div>
                                        <div class="chip-filter">
                                            <input type="checkbox" id="filterNew" class="filter-status" value="new"
                                                checked>
                                            <label for="filterNew" class="filter-chip">Yeni</label>
                                        </div>
                                        <div class="chip-filter">
                                            <input type="checkbox" id="filterSteady" class="filter-status"
                                                value="steady" checked>
                                            <label for="filterSteady" class="filter-chip">Duzenli</label>
                                        </div>
                                        <div class="chip-filter">
                                            <input type="checkbox" id="filterNormal" class="filter-status"
                                                value="normal" checked>
                                            <label for="filterNormal" class="filter-chip">Diger</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="position-relative">
                                <div id="map"></div>
                            </div>
                            <div class="map-footnote small text-muted mt-3">Bugun eklenen beslemeler haritada
                                vurgulanir.</div>
                        </div>

                        <div class="section-card p-3 p-lg-4 mt-4 gallery-card" id="miniGallery">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="section-title mb-0">Mini Galeri</h4>
                                <a class="btn btn-soft btn-sm" href="/gallery">Galeriye Git</a>
                            </div>
                            <div class="row g-3 mini-gallery">
                                <% gallery.forEach(g=>{ %>
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <a href="/gallery/<%= g.id %>-<%= slugify(g.title||'', {lower:true, strict:true}) %>"
                                            class="gallery-item">
                                            <img src="<%= g.image_path %>" class="img-fluid" alt="<%= g.title %>">
                                            <span>Detay</span>
                                        </a>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>

                        <div class="section-card p-3 p-lg-4 mt-4">
                            <h4 class="section-title mb-3">Top 5 Besleme Noktasi</h4>
                            <ul class="list-group list-group-flush top5-list" id="weeklyTop">
                                <li class="list-group-item">Yukleniyor...</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="section-card p-3 p-lg-4 announcements-card timeline-card">
                            <h4 class="section-title mb-3">Son Duyurular</h4>
                            <div class="list-group list-group-flush timeline-list">
                                <% data.slice(0,5).forEach(element=>{ %>
                                    <div class="list-group-item timeline-item">
                                        <span class="timeline-dot"></span>
                                        <div class="fw-semibold">
                                            <%= element.title %>
                                        </div>
                                        <div class="small text-muted mb-2">Duyuru detayi icin tikla</div>
                                        <a href="/announcements/<%=element.slug%>" class="btn btn-soft btn-sm">Detayi
                                            Gor</a>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                        <div class="section-card p-3 p-lg-4 mt-4">
                            <h4 class="section-title mb-3">Besleme Ekle 🐾</h4>
                            <div class="feed-steps mb-3">
                                <div class="feed-step">
                                    <span class="feed-step-dot">1</span>
                                    <span class="feed-step-label">Konum Seç</span>
                                </div>
                                <div class="feed-step">
                                    <span class="feed-step-dot">2</span>
                                    <span class="feed-step-label">Formu Doldur</span>
                                </div>
                                <div class="feed-step">
                                    <span class="feed-step-dot">3</span>
                                    <span class="feed-step-label">Kaydet</span>
                                </div>
                            </div>
                            <div id="feedHelpBar" class="feed-help mb-3" style="display:none;">Haritadan bir nokta
                                secerek yeni besleme ekleyebilirsiniz.</div>
                            <form method="POST" action="/api/feeds" enctype="multipart/form-data"
                                class="feed-form feed-form-card" id="feedCreateForm">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Yeni Besleme Kaydi</h5>
                                    <input type="hidden" name="lat" id="feedLat">
                                    <input type="hidden" name="lng" id="feedLng">
                                    <div class="mb-3 small text-muted" id="selectedLocationInfo">Henuz haritadan konum
                                        secmediniz.</div>
                                    <div class="mb-3">
                                        <label for="feedType" class="form-label">Besleme Tipi</label>
                                        <select name="type" id="feedType" class="form-select">
                                            <option value="mama">Kuru mama</option>
                                            <option value="yas_mama">Yas mama</option>
                                            <option value="yemek_artigi">Yemek artigi</option>
                                            <option value="su">Su</option>
                                            <option value="diger">Diger</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="feedNote" class="form-label">Not (istege bagli)</label>
                                        <textarea name="note" id="feedNote" class="form-control" rows="3"
                                            placeholder="Orn: 3 kedi + 1 kopek vardi, alan golgeli."></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label for="feedPhoto" class="form-label">Fotograf (opsiyonel)</label>
                                        <input type="file" name="photo" id="feedPhoto" class="form-control">
                                    </div>
                                    <div class="alert alert-success d-none" id="feedSuccessAlert">Tesekkurler! Besleme
                                        kaydiniz haritaya eklendi.</div>
                                    <div class="alert alert-danger d-none" id="feedErrorAlert"></div>
                                    <button type="submit" class="btn btn-main feed-submit-btn" disabled>Beslemeyi Kaydet
                                        🐾</button>
                                    <div class="form-text mt-2">* Once haritadan bir nokta secmeniz gerekiyor.</div>
                                </div>
                            </form>
                        </div>
                    </div>
                </section>

            </main>

            <div class="wave-divider">
                <svg viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0,64 C240,128 480,128 720,80 C960,32 1200,32 1440,64 L1440,150 L0,150 Z"></path>
                </svg>
            </div>

            <footer class="site-map mt-4" id="siteMap">
                <div class="container">
                    <div class="section-card p-3 p-lg-4">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h5 class="mb-2">Site Map</h5>
                                <p class="text-muted mb-0">Sokak Hayvanlari platformunda hizli erisim.</p>
                            </div>
                            <div class="col-md-8">
                                <div class="row g-2">
                                    <div class="col-6 col-lg-4"><a href="/" class="site-map-link">Ana Sayfa</a></div>
                                    <div class="col-6 col-lg-4"><a href="/#mapSection" class="site-map-link">Harita &
                                            Noktalar</a></div>
                                    <div class="col-6 col-lg-4"><a href="/#miniGallery" class="site-map-link">Galeri</a>
                                    </div>
                                    <div class="col-6 col-lg-4"><a href="/announcements"
                                            class="site-map-link">Duyurular</a></div>
                                    <div class="col-6 col-lg-4"><a href="/#about" class="site-map-link">Hakkinda</a>
                                    </div>
                                    <div class="col-6 col-lg-4"><a href="/auth/login" class="site-map-link">Giris /
                                            Admin</a></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="footer-links mt-4">
                        <div class="row align-items-center">
                        <div class="col-md-4">
                            <div class="footer-brand d-flex align-items-center gap-2">
                                <img src="/static/img/kedikopek.png" alt="Sokak Hayvanlari" class="site-logo">
                                <span>Sokak Hayvanlari</span>
                            </div>
                        </div>
                            <div class="col-md-4">
                                <div class="footer-nav">
                                    <a href="/#about">Hakkimizda</a>
                                    <a href="/announcements">Iletisim</a>
                                    <a href="/#mapSection">Gonullu Ol</a>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="footer-social">
