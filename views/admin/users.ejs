<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'users' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Kullanicilari gor' }) %>
            <div class="container-fluid py-4">
                <% if (typeof flash !== "undefined" && flash && flash.text) { %>
                    <div class="alert alert-<%= flash.type || 'info' %>"><%= flash.text %></div>
                <% } %>

                <!-- Hero Başlık -->
                <section class="admin-hero rounded-4 p-4 p-md-5 mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="eyebrow text-uppercase">Yönetim • Kullanıcılar</div>
                            <h2 class="hero-heading mb-2"><%= contentTitle || 'Kullanıcılar' %></h2>
                            <p class="mb-0 hero-sub">Kayıtlı kullanıcıları görüntüleyin ve rollerini inceleyin.</p>
                        </div>
                        <div class="quick-actions d-flex flex-wrap gap-2">
                            <a href="/auth/login" class="btn btn-light btn-action">Yeni Admin Oluştur</a>
                        </div>
                    </div>
                </section>

                <div class="row g-4">
                    <div class="col-12">
                        <div class="admin-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Kullanicilar</h5>
                                <span class="badge bg-info bg-opacity-20 text-info"><%= users.length %> kayit</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Id</th>
                                            <th>Ad Soyad</th>
                                            <th>E-posta</th>
                                            <th>Rol</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% users.forEach(u=>{ %>
                                            <tr>
                                                <td><%= u.userid %></td>
                                                <td><%= (u.name || '') %> <%= (u.surname || '') %></td>
                                                <td><%= u.email %></td>
                                                <td>
                                                    <% if (u.roles) { %>
                                                        <span class="badge bg-primary bg-opacity-20 text-primary"><%= u.roles %></span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary bg-opacity-20 text-secondary">-</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <% if (users.length === 0) { %>
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Kayit bulunmuyor
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <style>
        /* Hero alanı */
        .admin-hero {
            background: radial-gradient(1200px 400px at -10% -20%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 60%),
                        linear-gradient(135deg, var(--pet-red), #0b2d52);
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .admin-hero .eyebrow { letter-spacing: .08em; font-size: .8rem; opacity: .9; }
        .admin-hero .hero-heading { font-weight: 800; }
        .admin-hero .hero-sub { opacity: .95; }
        .btn-action { background: rgba(255,255,255,.92); border: 1px solid rgba(0,0,0,.06); box-shadow: 0 6px 18px rgba(0,0,0,.06); }
        .btn-action:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.08); }

        /* Tablo ve kart cilası */
        .admin-card { border: 1px solid rgba(26, 107, 181, 0.08); border-radius: 16px; background: #fff; box-shadow: 0 8px 24px rgba(26,107,181,.06); }
        .table thead th { background: rgba(26,107,181,.06); color: var(--pet-ink); font-weight: 600; border-bottom: 2px solid rgba(26,107,181,.1); }
        .table tbody tr:hover { background: rgba(26,107,181,.03); }
    </style>
    <%- include('../partials/script') %>
</body>
</html>
