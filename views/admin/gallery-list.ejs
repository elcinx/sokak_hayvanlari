<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'gallery' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Galeri gorunumu ve yonetimi' }) %>
            <div class="container-fluid py-4">
                <% if (flash && flash.text) { %>
                    <div class="alert alert-<%= flash.type || 'info' %>"><%= flash.text %></div>
                <% } %>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div></div>
                    <a href="/admin/gallery/add" class="btn btn-pet">Yeni Yukle</a>
                </div>
                <% if (items.length === 0) { %>
                    <div class="admin-card p-4 text-center">Henuz gorsel yok.</div>
                <% } %>
                <div class="row g-3">
                    <% items.forEach(item=>{ %>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="admin-card admin-gallery-item">
                                <% const imageUrl = item.image_url || item.url; %>
                                <% if (imageUrl) { %>
                                    <img src="<%= imageUrl %>" alt="<%= item.title %>" class="w-100" style="height:220px;object-fit:cover;">
                                <% } %>
                                <div class="admin-gallery-overlay">
                                    <form method="POST" action="/admin/gallery/delete/<%= item.id %>">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-light">Sil</button>
                                    </form>
                                </div>
                                <div class="p-3">
                                    <div class="fw-semibold"><%= item.title %></div>
                                    <div class="small text-muted"><%= item.owner || 'Bilinmiyor' %></div>
                                    <div class="small text-muted"><%= item.created_at %></div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
