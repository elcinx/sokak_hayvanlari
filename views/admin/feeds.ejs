<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'feeds' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Besleme kayıtlarını yönetin' }) %>
            <div class="container-fluid py-4">
                <!-- Header Stats -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="admin-card stat-card-enhanced p-3">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon-enhanced bg-primary bg-opacity-10 me-3">
                                    <i class="bi bi-bowl-rice text-primary"></i>
                                </div>
                                <div>
                                    <div class="small text-muted">Toplam Besleme</div>
                                    <div class="h5 mb-0 fw-bold text-primary"><%= feeds.length %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="admin-card stat-card-enhanced p-3">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon-enhanced bg-success bg-opacity-10 me-3">
                                    <i class="bi bi-image text-success"></i>
                                </div>
                                <div>
                                    <div class="small text-muted">Fotoğraflı</div>
                                    <div class="h5 mb-0 fw-bold text-success">
                                        <%= feeds.filter(f => f.photo_url).length %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="admin-card stat-card-enhanced p-3">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon-enhanced bg-warning bg-opacity-10 me-3">
                                    <i class="bi bi-geo-alt text-warning"></i>
                                </div>
                                <div>
                                    <div class="small text-muted">Konumlu</div>
                                    <div class="h5 mb-0 fw-bold text-warning">
                                        <%= feeds.filter(f => f.lat && f.lng).length %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="admin-card stat-card-enhanced p-3">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon-enhanced bg-info bg-opacity-10 me-3">
                                    <i class="bi bi-chat-dots text-info"></i>
                                </div>
                                <div>
                                    <div class="small text-muted">Toplam Yorum</div>
                                    <div class="h5 mb-0 fw-bold text-info">
                                        <%= feeds.reduce((sum, f) => sum + (f.comment_count || 0), 0) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Filters -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="search-box">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="search" class="form-control border-start-0" id="feedSearch" 
                                       placeholder="Besleme ara...">
                            </div>
                        </div>
                        <div class="filter-buttons">
                            <button class="btn btn-outline-secondary btn-sm active" data-filter="all">
                                Tümü
                            </button>
                            <button class="btn btn-outline-success btn-sm" data-filter="with-photo">
                                Fotoğraflı
                            </button>
                            <button class="btn btn-outline-warning btn-sm" data-filter="with-location">
                                Konumlu
                            </button>
                        </div>
                    </div>
                    <div class="text-muted">
                        Sayfa <%= page %> / <%= totalPages %>
                    </div>
                </div>
                
                <!-- Feeds Table -->
                <div class="admin-card p-4">
                    <% if (feeds.length === 0) { %>
                        <div class="empty-state text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                            <h5 class="text-muted">Henüz besleme kaydı bulunmuyor</h5>
                            <p class="text-muted">Kullanıcıların besleme kayıtları burada görünecek.</p>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Görsel</th>
                                        <th>Kullanıcı</th>
                                        <th>Tarih</th>
                                        <th>Konum</th>
                                        <th>Not</th>
                                        <th>Etkileşim</th>
                                        <th>Puan</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% feeds.forEach(f=>{ %>
                                        <tr class="feed-row" data-photo="<%= f.photo_url ? 'yes' : 'no' %>" 
                                            data-location="<%= (f.lat && f.lng) ? 'yes' : 'no' %>">
                                            <td>
                                                <% if(f.photo_url){ %>
                                                    <div class="feed-photo-container">
                                                        <img src="<%= f.photo_url %>" class="feed-thumbnail" 
                                                             alt="Besleme görseli" onclick="viewImage('<%= f.photo_url %>')">
                                                        <div class="photo-badge">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    </div>
                                                <% } else { %>
                                                    <div class="no-photo-placeholder">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2">
                                                        <i class="bi bi-person text-primary fs-6"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold"><%= f.name || 'Kullanıcı' %></div>
                                                        <div class="small text-muted">ID: <%= f.userid || 'N/A' %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-muted small">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    <%= f.created_at %>
                                                </div>
                                            </td>
                                            <td>
                                                <% if(f.lat && f.lng){ %>
                                                    <div class="location-info">
                                                        <div class="small text-muted">
                                                            <i class="bi bi-geo-alt me-1"></i>
                                                            <%= f.lat.substring(0, 6) %>, <%= f.lng.substring(0, 6) %>
                                                        </div>
                                                        <button class="btn btn-link p-0 text-decoration-none" 
                                                                onclick="openMap('<%= f.lat %>', '<%= f.lng %>')">
                                                            <small class="text-primary">Haritada gör</small>
                                                        </button>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="note-content">
                                                    <% if(f.note){ %>
                                                        <div class="note-text" title="<%= f.note %>">
                                                            <%= f.note.length > 50 ? f.note.substring(0, 50) + '...' : f.note %>
                                                        </div>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                    <% } %>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="interaction-badges">
                                                    <div class="d-flex gap-1">
                                                        <span class="badge bg-primary bg-opacity-20 text-primary">
                                                            <i class="bi bi-chat"></i> <%= f.comment_count || 0 %>
                                                        </span>
                                                        <span class="badge bg-danger bg-opacity-20 text-danger">
                                                            <i class="bi bi-heart"></i> <%= f.like_count || 0 %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-20 text-success fw-semibold">
                                                    <%= f.points || 0 %> puan
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/feeds/<%= f.id %>" class="btn btn-outline-primary" title="Detay">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="/admin/feeds/delete/<%= f.id %>" 
                                                       class="btn btn-outline-danger" title="Sil"
                                                       onclick="return confirm('Bu besleme kaydını silmek istediğinizden emin misiniz?')">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                    
                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                        <nav aria-label="Sayfalama" class="mt-4">
                            <ul class="pagination justify-content-center mb-0">
                                <% if(page > 1){ %>
                                    <li class="page-item">
                                        <a class="page-link" href="/admin/feeds?page=<%= page-1 %>">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                <% } %>
                                <% for(let i=1;i<=totalPages;i++){ %>
                                    <% if(i === page || i === 1 || i === totalPages || (i >= page-1 && i <= page+1)){ %>
                                        <li class="page-item <%= i===page?'active':'' %>">
                                            <a class="page-link" href="/admin/feeds?page=<%= i %>"><%= i %></a>
                                        </li>
                                    <% } else if(i === page-2 || i === page+2){ %>
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    <% } %>
                                <% } %>
                                <% if(page < totalPages){ %>
                                    <li class="page-item">
                                        <a class="page-link" href="/admin/feeds?page=<%= page+1 %>">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                <% } %>
                            </ul>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Image Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white">Besleme Görseli</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <img id="modalImage" src="" alt="Besleme görseli" class="w-100">
                </div>
            </div>
        </div>
    </div>

    <style>
        .stat-card-enhanced {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border: 1px solid rgba(26, 107, 181, 0.1);
            transition: all 0.3s ease;
        }
        
        .stat-card-enhanced:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(26, 107, 181, 0.15);
        }
        
        .stat-icon-enhanced {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .feed-photo-container {
            position: relative;
            display: inline-block;
        }
        
        .feed-thumbnail {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        
        .feed-thumbnail:hover {
            transform: scale(1.1);
        }
        
        .photo-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--pet-red);
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
        }
        
        .no-photo-placeholder {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(26, 107, 181, 0.05);
            border-radius: 8px;
            font-size: 1.5rem;
        }
        
        .avatar-sm {
            width: 32px;
            height: 32px;
        }
        
        .note-text {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.875rem;
        }
        
        .interaction-badges .badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }
        
        .feed-row {
            transition: background-color 0.3s ease;
        }
        
        .feed-row:hover {
            background-color: rgba(26, 107, 181, 0.03) !important;
        }
        
        .table thead th {
            background: rgba(26, 107, 181, 0.05);
            border-bottom: 2px solid rgba(26, 107, 181, 0.1);
            font-weight: 600;
            color: var(--pet-ink);
        }
        
        .pagination .page-link {
            border-color: rgba(26, 107, 181, 0.2);
            color: var(--pet-red);
        }
        
        .pagination .page-link:hover {
            background-color: rgba(26, 107, 181, 0.1);
            border-color: var(--pet-red);
        }
        
        .pagination .page-item.active .page-link {
            background-color: var(--pet-red);
            border-color: var(--pet-red);
        }
        
        .empty-state {
            background: rgba(26, 107, 181, 0.02);
            border: 2px dashed rgba(26, 107, 181, 0.2);
            border-radius: 12px;
        }
        
        @media (max-width: 768px) {
            .feed-thumbnail {
                width: 50px;
                height: 50px;
            }
            
            .avatar-sm {
                width: 28px;
                height: 28px;
            }
            
            .note-text {
                max-width: 150px;
                font-size: 0.8rem;
            }
        }
    </style>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Filter functionality
            const filterButtons = document.querySelectorAll('.filter-buttons .btn');
            const feedRows = document.querySelectorAll('.feed-row');
            
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Update active state
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    const filter = this.dataset.filter;
                    
                    // Filter feeds
                    feedRows.forEach(row => {
                        if (filter === 'all') {
                            row.style.display = '';
                        } else if (filter === 'with-photo') {
                            row.style.display = row.dataset.photo === 'yes' ? '' : 'none';
                        } else if (filter === 'with-location') {
                            row.style.display = row.dataset.location === 'yes' ? '' : 'none';
                        }
                    });
                });
            });
            
            // Search functionality
            const searchInput = document.getElementById('feedSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    
                    feedRows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(searchTerm) ? '' : 'none';
                    });
                });
            }
        });
        
        // View image in modal
        function viewImage(imageUrl) {
            if (imageUrl) {
                document.getElementById('modalImage').src = imageUrl;
                const modal = new bootstrap.Modal(document.getElementById('imageModal'));
                modal.show();
            }
        }
        
        // Open map (mock function)
        function openMap(lat, lng) {
            window.open(`https://www.google.com/maps?q=${lat},${lng}`, '_blank');
        }
    </script>
    
    <%- include('../partials/script') %>
</body>
</html>
