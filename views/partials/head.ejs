    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <title><%= title %></title>
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="/static/template/assets/favicon.ico" />
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="/static/template/css/styles.css" rel="stylesheet" />
        <!-- Leaflet -->
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        />
        <style>
            :root {
                --pet-red: #c62828;
                --pet-red-light: #ff5252;
                --pet-bg: #fff5f5;
                --pet-card: #ffffff;
                --pet-ink: #2b1c1c;
                --pet-shadow: 0 12px 30px rgba(198, 40, 40, 0.12);
            }
            body.pet-theme {
                background: var(--pet-bg);
                color: var(--pet-ink);
                font-family: "Times New Roman", serif;
            }
            .ck-editor__editable[role="textbox"] {
                min-height: 200px;
            }
            #map {
                width: 100%;
                min-height: 440px;
                border: 1px solid rgba(198, 40, 40, 0.2);
                border-radius: 16px;
            }
            .pet-navbar {
                background: linear-gradient(120deg, #c62828, #ff5252);
                box-shadow: 0 10px 24px rgba(198, 40, 40, 0.25);
            }
            .pet-navbar .navbar-brand,
            .pet-navbar .nav-link {
                color: #fff !important;
            }
            .pet-navbar .nav-link:hover {
                color: #ffe3e3 !important;
            }
            .hero {
                background: linear-gradient(120deg, rgba(198, 40, 40, 0.9), rgba(255, 82, 82, 0.75)),
                    url("https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=1400&q=80") center/cover no-repeat;
                border-radius: 22px;
                color: #fff;
                padding: 60px 40px;
                position: relative;
                overflow: hidden;
            }
            .hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(0, 0, 0, 0.25);
            }
            .hero > * {
                position: relative;
                z-index: 1;
            }
            .hero-title {
                font-size: clamp(2rem, 3vw, 3rem);
                font-weight: 700;
            }
            .hero-subtitle {
                font-size: 1.1rem;
                max-width: 560px;
                opacity: 0.9;
            }
            .stat-card {
                background: var(--pet-card);
                border-radius: 16px;
                box-shadow: var(--pet-shadow);
                border: 1px solid rgba(198, 40, 40, 0.12);
                transition: transform 0.2s ease;
            }
            .stat-card:hover {
                transform: translateY(-4px);
            }
            .stat-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 82, 82, 0.15);
                color: var(--pet-red);
                font-size: 20px;
            }
            .section-card {
                background: var(--pet-card);
                border-radius: 18px;
                border: 1px solid rgba(198, 40, 40, 0.12);
                box-shadow: var(--pet-shadow);
            }
            .btn-pet {
                background: var(--pet-red);
                border-color: var(--pet-red);
                color: #fff;
            }
            .btn-pet:hover {
                background: #b71c1c;
                border-color: #b71c1c;
                color: #fff;
            }
            .btn-pet-outline {
                border-color: #fff;
                color: #fff;
                background: transparent;
            }
            .btn-pet-outline:hover {
                background: #fff;
                color: var(--pet-red);
            }
            .map-toolbar .btn,
            .map-toolbar .form-check-label {
                font-size: 0.85rem;
            }
            .mini-gallery img {
                border-radius: 12px;
                transition: transform 0.2s ease, filter 0.2s ease;
            }
            .mini-gallery a:hover img {
                transform: scale(1.03);
                filter: brightness(0.85);
            }
            .mini-gallery a {
                position: relative;
                display: block;
            }
            .mini-gallery a span {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 20px;
                opacity: 0;
                transition: opacity 0.2s ease;
            }
            .mini-gallery a:hover span {
                opacity: 1;
            }
            .rank-badge {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(198, 40, 40, 0.15);
                color: var(--pet-red);
                font-weight: 700;
            }
            .login-card {
                max-width: 420px;
                margin: 8vh auto;
                background: var(--pet-card);
                border-radius: 20px;
                box-shadow: var(--pet-shadow);
                border: 1px solid rgba(198, 40, 40, 0.12);
            }
            .form-control:focus,
            .form-check-input:focus {
                border-color: var(--pet-red);
                box-shadow: 0 0 0 0.2rem rgba(198, 40, 40, 0.2);
            }
        </style>
    </head>
