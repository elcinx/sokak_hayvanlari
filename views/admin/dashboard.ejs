<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body>
    <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-primary" id="sidebarToggle">Menü</button>
                    <%- include('../partials/right-top-menu') %>
                </div>
            </nav>
            <div class="container-fluid">
                <h1 class="mt-3"><%= contentTitle %></h1>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light border rounded shadow-sm">
                            <div class="small text-muted">Toplam Besleme</div>
                            <div class="h4 mb-0"><%= stats.totalFeeds %></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light border rounded shadow-sm">
                            <div class="small text-muted">Bugün Besleme</div>
                            <div class="h4 mb-0"><%= stats.todayFeeds %></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light border rounded shadow-sm">
                            <div class="small text-muted">Aktif Nokta</div>
                            <div class="h4 mb-0"><%= stats.activePoints %></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light border rounded shadow-sm">
                            <div class="small text-muted">Online</div>
                            <div class="h4 mb-0"><%= stats.online %></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-5">
                        <h4>Haftalık Top 5</h4>
                        <ul class="list-group mb-4">
                            <% weekly.forEach((w,idx)=>{ %>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span><%= idx+1 %>. <%= w.name %></span>
                                    <span><%= w.points %></span>
                                </li>
                            <% }) %>
                            <% if (weekly.length===0){ %>
                                <li class="list-group-item">Veri yok</li>
                            <% } %>
                        </ul>
                    </div>
                    <div class="col-lg-7">
                        <h4>Son 10 Besleme</h4>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Foto</th>
                                        <th>Kullanıcı</th>
                                        <th>Tarih</th>
                                        <th>Konum</th>
                                        <th>Puan</th>
                                        <th>Y/L</th>
                                        <th>İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% feeds.forEach(f=>{ %>
                                        <tr>
                                            <td style="width:70px">
                                                <% if(f.photo_path){ %>
                                                    <img src="/<%= f.photo_path %>" style="width:60px;height:60px;object-fit:cover;">
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                            <td><%= f.name || 'Kullanıcı' %></td>
                                            <td><%= f.created_at %></td>
                                            <td><%= f.lat %>, <%= f.lng %></td>
                                            <td><%= f.points %></td>
                                            <td><%= f.comment_count %>/<%= f.like_count %></td>
                                            <td>
                                                <a href="/feeds/<%= f.id %>" class="btn btn-sm btn-outline-primary">Detay</a>
                                                <a href="/admin/feeds/delete/<%= f.id %>" class="btn btn-sm btn-outline-danger">Sil</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
