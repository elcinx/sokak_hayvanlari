<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body>
    <div class="container py-4">
        <h1 class="mb-4"><%= contentTitle %></h1>
        <div class="row g-3">
            <% if (items.length===0){ %>
                <p>Henüz galeri içeriği yok.</p>
            <% } %>
            <% items.forEach(item=>{ %>
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= item.image_path %>" class="card-img-top" alt="<%= item.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= item.title %></h5>
                            <p class="card-text"><small class="text-muted">Yükleyen: <%= item.owner || 'Bilinmiyor' %></small></p>
                            <a href="/gallery/<%= item.id %>-<%= require('slugify')(item.title||'', {lower:true, strict:true}) %>" class="btn btn-outline-primary btn-sm">Görüntüle</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
