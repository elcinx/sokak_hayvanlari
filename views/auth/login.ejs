<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme">
    <div class="login-container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="login-wrapper">
            <div class="login-tabs mb-4">
                <div class="tab-buttons">
                    <button class="tab-btn active" data-tab="admin">
                        <i class="bi bi-shield-lock me-2"></i>Admin Girişi
                    </button>
                    <button class="tab-btn" data-tab="user">
                        <i class="bi bi-person me-2"></i>Kullanıcı Girişi
                    </button>
                </div>
            </div>
            <div class="login-card admin-login active" id="adminTab">
                <div class="text-center mb-4">
                    <div class="login-logo mb-3">
                        <img src="/static/img/kedikopek.png" alt="Logo" class="img-fluid" style="max-height: 80px;">
                    </div>
                    <h2 class="mb-2 fw-bold text-primary">Admin Girişi</h2>
                    <p class="text-muted">Yönetim paneli için giriş yapınız</p>
                    <a href="/" class="btn btn-outline-primary btn-sm mt-2">Ana Sayfaya Don</a>
                </div>
                
                <form action="/auth/login" method="post" class="login-form">
                    <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                    <input type="hidden" name="role" value="admin">
                    
                    <% if (typeof(message)!="undefined") { %>
                        <div class="alert alert-<%=message.class%> d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <%=message.text %>
                        </div>
                    <% } %>
                    
                    <div class="mb-4">
                        <label for="email" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-2"></i>E-posta Adresi
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>
                            <input name="email" type="email" class="form-control border-start-0" 
                                   value="<%=authinfo.email %>" 
                                   placeholder="admin@example.com" 
                                   required>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">
                            <i class="bi bi-lock me-2"></i>Şifre
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input name="password" type="password" class="form-control border-start-0" 
                                   value="<%=authinfo.password %>" 
                                   placeholder="••••••••" 
                                   required>
                            <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" value="1" 
                                   name="cbhatirla" <%=authinfo.password?"checked":null %>>
                            <label class="form-check-label" for="rememberMe">
                                Beni hatırla
                            </label>
                        </div>
                        <a href="/auth/reset-password" class="text-decoration-none text-primary small">
                            Şifremi unuttum
                        </a>
                    </div>
                    
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold admin-login-btn" id="loginBtn">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Admin Girişi
                        </button>
                    </div>
                </form>

                <div class="admin-create-card mt-4">
                    <a class="btn btn-outline-primary w-100 admin-create-toggle" href="/auth/admin-register">
                        <span class="admin-create-icon me-2">🛡️</span>Yeni Admin Olustur
                    </a>
                </div>
                
                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Güvenli admin giriş sistemi
                    </small>
                </div>
            </div>
            
            <!-- User Login Card -->
            <div class="login-card user-login" id="userTab">
                <div class="text-center mb-4">
                    <div class="login-logo mb-3">
                        <img src="/static/img/kedikopek.png" alt="Logo" class="img-fluid" style="max-height: 80px;">
                    </div>
                    <h2 class="mb-2 fw-bold text-primary">Kullanıcı Girişi</h2>
                    <p class="text-muted">Platforma giriş yapın</p>
                    <a href="/" class="btn btn-outline-primary btn-sm mt-2">Ana Sayfaya Don</a>
                </div>
                
                <form action="/auth/login" method="post" class="login-form">
                    <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                    <input type="hidden" name="role" value="user">
                    
                    <div class="mb-4">
                        <label for="userEmail" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-2"></i>E-posta Adresi
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>
                            <input name="email" type="email" class="form-control border-start-0" 
                                   id="userEmail"
                                   placeholder="kullanici@example.com" 
                                   required>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="userPassword" class="form-label fw-semibold">
                            <i class="bi bi-lock me-2"></i>Şifre
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input name="password" type="password" class="form-control border-start-0" 
                                   id="userPassword"
                                   placeholder="••••••••" 
                                   required>
                            <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleUserPassword">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="userRemember" value="1" 
                                   name="cbhatirla">
                            <label class="form-check-label" for="userRemember">
                                Beni hatırla
                            </label>
                        </div>
                        <a href="/auth/reset-password" class="text-decoration-none text-primary small">
                            Şifremi unuttum
                        </a>
                    </div>
                    
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold user-login-btn">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                        </button>
                        <div class="text-center">
                            <small class="text-muted">
                                Hesabınız yok mu? 
                                <a href="/auth/register" class="text-primary text-decoration-none">Kayıt Ol</a>
                            </small>
                        </div>
                    </div>
                </form>
                
                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Güvenli kullanıcı giriş sistemi
                    </small>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        .login-container {
            background: linear-gradient(135deg, #eaf4ff 0%, #d4e9ff 50%, #c8e6ff 100%);
            position: relative;
            overflow: hidden;
        }
        
        .login-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(26, 107, 181, 0.1) 0%, transparent 70%);
            animation: float 20s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(30px, -30px) rotate(180deg); }
        }
        
        .login-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }
        
        .login-tabs {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 8px;
            box-shadow: 0 10px 30px rgba(26, 107, 181, 0.1);
        }
        
        .tab-buttons {
            display: flex;
            gap: 8px;
        }
        
        .tab-btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            background: transparent;
            border-radius: 12px;
            font-weight: 600;
            color: #6c757d;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }
        
        .tab-btn:hover {
            background: rgba(26, 107, 181, 0.05);
            color: var(--pet-red);
        }
        
        .tab-btn.active {
            background: var(--pet-red);
            color: white;
            box-shadow: 0 4px 12px rgba(26, 107, 181, 0.3);
        }
        
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 40px rgba(26, 107, 181, 0.15);
            transition: all 0.3s ease;
            padding: 40px;
            display: none;
        }
        
        .login-card.active {
            display: block;
        }
        
        .login-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(26, 107, 181, 0.2);
        }
        
        .login-logo img {
            transition: transform 0.3s ease;
        }
        
        .login-logo:hover img {
            transform: scale(1.05);
        }
        
        .form-control, .input-group-text {
            border-radius: 12px;
            border: 2px solid #e3f2fd;
            transition: all 0.3s ease;
            background-color: #ffffff;
        }
        
        .form-control:focus {
            border-color: var(--pet-red);
            box-shadow: 0 0 0 0.2rem rgba(26, 107, 181, 0.15);
            background-color: #fafcff;
        }
        
        .input-group .form-control {
            border-radius: 0 12px 12px 0;
        }
        
        .input-group .input-group-text {
            border-radius: 12px 0 0 12px;
            border-right: none;
            background-color: #f8f9fa;
        }
        
        .form-label {
            color: #495057;
            font-weight: 600;
        }
        
        .btn-primary {
            background: linear-gradient(90deg, #1a6bb5, #0b2d52);
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }
        
        .btn-primary:hover::before {
            left: 100%;
        }
        
        .btn-primary:hover {
            background: linear-gradient(90deg, #2a7bd0, #0b2d52);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(26, 107, 181, 0.3);
        }
        
        .form-check-input:checked {
            background-color: var(--pet-red);
            border-color: var(--pet-red);
        }
        
        .alert {
            border-radius: 12px;
            border: none;
            animation: slideDown 0.3s ease;
        }
        
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .text-primary {
            color: var(--pet-red) !important;
        }

        .admin-create-card {
            border: 1px dashed rgba(26, 107, 181, 0.3);
            border-radius: 16px;
            padding: 16px;
            background: rgba(255, 255, 255, 0.8);
        }

        .admin-create-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(26, 107, 181, 0.1);
            border-radius: 10px;
        }

        .admin-create-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        
        @media (max-width: 480px) {
            .login-wrapper {
                padding: 10px;
            }
            
            .login-card {
                padding: 30px 20px !important;
            }
        }
    </style>
    
    <script src="/js/login.js" defer></script>
    <%- include('../partials/script') %>
</body>
</html>

