<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme">
    <%- include('../partials/navbar') %>
    <div class="container py-4">
        <a href="/" class="btn btn-link ps-0">&larr; Haritaya don</a>
        <div class="section-card p-4">
            <div class="row g-4">
                <div class="col-md-8">
                <% if (feed.photo_url){ %>
                    <img src="<%= feed.photo_url %>" class="img-fluid rounded mb-3" alt="feed photo">
                <% } %>
                <h3>Besleme</h3>
                <p><strong>Kullanıcı:</strong> <%= feed.name || 'Anonim' %></p>
                <p><strong>Tarih:</strong> <%= feed.created_at %></p>
                <p><strong>Not:</strong> <%= feed.note || '-' %></p>
                <p><strong>Konum:</strong> <%= feed.lat %>, <%= feed.lng %></p>
                </div>
                <div class="col-md-4">
                <h4>Yorumlar</h4>
                <div id="comments">
                    <% if (comments.length===0){ %>
                        <p>Henüz yorum yok.</p>
                    <% } %>
                    <% comments.forEach(c=>{ %>
                        <div class="border rounded p-2 mb-2">
                            <div class="fw-bold"><%= c.name %></div>
                            <div class="text-muted"><small><%= c.created_at %></small></div>
                            <div><%= c.content %></div>
                        </div>
                    <% }) %>
                </div>
                <div class="mt-3">
                    <h5>Yorum ekle</h5>
                    <form method="post" action="/api/feeds/<%= feed.id %>/comments">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="mb-2">
                            <textarea name="content" class="form-control" rows="3" maxlength="500" placeholder="Yorumunuzu yazın"></textarea>
                        </div>
                        <button type="submit" class="btn btn-pet btn-sm">Gonder</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
