    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <title><%= title %></title>
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="/static/template/assets/favicon.ico" />
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="/static/template/css/styles.css" rel="stylesheet" />
        <!-- Leaflet -->
        <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        />
        <style>
            :root {
                --pet-red: #c62828;
                --pet-red-dark: #8e0000;
                --pet-cream: #fff7f0;
                --pet-brown: #4a2f28;
                --pet-shadow: 0 10px 30px rgba(124, 22, 22, 0.12);
            }
            .ck-editor__editable[role="textbox"] {
                min-height: 200px;
            }
            #map {
                width: 100%;
                min-height: 400px;
                border: 1px solid #e5e5e5;
                border-radius: 8px;
            }
            .pet-theme {
                font-family: "Times New Roman", serif;
                color: var(--pet-brown);
                background: radial-gradient(circle at 20% 10%, #ffe3d6 0%, #fff7f0 45%, #fff 100%);
            }
            .pet-theme .navbar,
            .pet-theme .bg-light {
                background: linear-gradient(90deg, #ffe3d6 0%, #fff7f0 100%) !important;
            }
            .pet-theme h1,
            .pet-theme h2,
            .pet-theme h3,
            .pet-theme h4 {
                color: var(--pet-red-dark);
                letter-spacing: 0.3px;
            }
            .pet-theme .btn-primary {
                background-color: var(--pet-red);
                border-color: var(--pet-red);
            }
            .pet-theme .btn-primary:hover {
                background-color: var(--pet-red-dark);
                border-color: var(--pet-red-dark);
            }
            .pet-theme .btn-outline-primary {
                color: var(--pet-red);
                border-color: var(--pet-red);
            }
            .pet-theme .btn-outline-primary:hover {
                background-color: var(--pet-red);
                border-color: var(--pet-red);
                color: #fff;
            }
            .pet-theme .card,
            .pet-theme .alert {
                border-radius: 14px;
                box-shadow: var(--pet-shadow);
                border: 1px solid rgba(198, 40, 40, 0.12);
            }
            .pet-theme #map {
                box-shadow: var(--pet-shadow);
                border-color: rgba(198, 40, 40, 0.25);
            }
            .pet-theme .list-group-item {
                border-color: rgba(198, 40, 40, 0.12);
            }
            .pet-theme a {
                color: var(--pet-red-dark);
            }
            .pet-theme a:hover {
                color: var(--pet-red);
            }
        </style>
    </head>
