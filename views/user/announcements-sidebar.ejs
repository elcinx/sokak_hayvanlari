<div class="section-card p-3">
    <h5 class="mb-3">Duyurular</h5>
    <div class="list-group list-group-flush">
        <% data.slice(0,5).forEach((element,index) => { %>
            <a href="/announcements/<%=element.slug%>" class="list-group-item list-group-item-action">
                <strong><%= element.title %></strong>
            </a>
        <% }) %>
    </div>
</div>
