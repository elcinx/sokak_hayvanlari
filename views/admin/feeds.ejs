<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body>
    <div class="d-flex" id="wrapper">
        <%- include('../partials/sidebar') %>
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-primary" id="sidebarToggle">Menü</button>
                    <%- include('../partials/right-top-menu') %>
                </div>
            </nav>
            <div class="container-fluid">
                <h1 class="mt-3"><%= contentTitle %></h1>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Foto</th>
                                <th>Kullanıcı</th>
                                <th>Tarih</th>
                                <th>Konum</th>
                                <th>Not</th>
                                <th>Y/L</th>
                                <th>Puan</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% feeds.forEach(f=>{ %>
                                <tr>
                                    <td style="width:70px">
                                        <% if(f.photo_url){ %>
                                            <img src="<%= f.photo_url %>" style="width:60px;height:60px;object-fit:cover;">
                                        <% } else { %>-<% } %>
                                    </td>
                                    <td><%= f.name || 'Kullanıcı' %></td>
                                    <td><%= f.created_at %></td>
                                    <td><%= f.lat %>, <%= f.lng %></td>
                                    <td><%= (f.note || '').slice(0,50) %></td>
                                    <td><%= f.comment_count %>/<%= f.like_count %></td>
                                    <td><%= f.points %></td>
                                    <td class="text-nowrap">
                                        <a href="/feeds/<%= f.id %>" class="btn btn-sm btn-outline-primary">Detay</a>
                                        <a href="/admin/feeds/delete/<%= f.id %>" class="btn btn-sm btn-outline-danger">Sil</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <nav aria-label="page">
                    <ul class="pagination">
                        <% for(let i=1;i<=totalPages;i++){ %>
                            <li class="page-item <%= i===page?'active':'' %>">
                                <a class="page-link" href="/admin/feeds?page=<%= i %>"><%= i %></a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
