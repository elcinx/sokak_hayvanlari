<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme">
    <%- include('../partials/navbar') %>
    <div class="container py-4 announcements-page">
        <div class="announcements-hero section-card p-4 p-lg-5 mb-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="hero-eyebrow text-uppercase">Guncel Bilgilendirme</div>
                    <h1 class="hero-title mb-2"><%= contentTitle %></h1>
                    <p class="section-subtitle mb-0">Toplulugumuzdan en yeni haberler, etkinlikler ve duyurular.</p>
                </div>
            </div>
        </div>

        <% if (data.length === 0) { %>
            <div class="section-card p-4 text-center text-muted">Henuz duyuru yok.</div>
        <% } %>

        <div class="row g-4">
            <% 
            const sampleAnnouncements = [
                {
                    id: 1,
                    title: "Sahilde Sokak Hayvanları İçin Mama Dağıtımı Gerçekleştirildi",
                    description: "Yerel gönüllüler sahil bölgesinde sokak hayvanlarına mama desteği sağladı.",
                    category: "Etkinlik",
                    publish_at: "20 Aralık 2024",
                    image: "/img/2.jpg",
                    views: 1850,
                    fullContent: "Şehrimizin sahil hattında yaşayan sokak hayvanları için gönüllü ekibimiz mama dağıtımı gerçekleştirdi. Soğuk kış günlerinde onların beslenmesini desteklemek amacıyla düzenlenen etkinlikte hem mama verildi hem de sağlık kontrolleri yapıldı.\n\nBu tarz etkinliklerin devam etmesi için halkımızdan mama desteği ve gönüllü katılım bekliyoruz."
                },
                {
                    id: 2,
                    title: "Kış Yaklaşıyor: Sokak Dostlarımız İçin Battaniye ve Mama Kampanyası",
                    description: "Soğuk hava koşullarında hayvanların beslenmesi ve barınması için ortak destek kampanyası başladı.",
                    category: "Kampanya",
                    publish_at: "18 Aralık 2024",
                    image: "/img/3.jpg",
                    views: 2340,
                    fullContent: "Kar yağışının yoğunlaştığı bu dönemlerde sokakta yaşam mücadelesi veren dostlarımız için yeni bir yardım kampanyası başlattık. Mama, su kabı, battaniye ve küçük kulübeler yaparak destek olabilirsiniz.\n\nKampanya kapsamında toplanan yardım malzemeleri belirlenen noktalara ekiplerimiz tarafından ulaştırılacaktır."
                },
                {
                    id: 3,
                    title: "Mahalle Besleme Noktaları Güncellendi – Gönüllüler Aranıyor",
                    description: "Yeni besleme noktaları oluşturuldu, düzenli kontrol için gönüllüler bekleniyor.",
                    category: "Çağrı",
                    publish_at: "15 Aralık 2024",
                    image: "/img/4.jpg",
                    views: 1560,
                    fullContent: "Şehrimizde belirli bölgelere yeni mama-su kapları yerleştirildi. Ancak düzenli besleme ve temizlik için gönüllülere ihtiyacımız var. Her gün 10-15 dakikanızı ayırarak bir canın hayatına dokunabilirsiniz.\n\nKatılmak isteyenler iletişim bölümünden başvuru yapabilir."
                },
                {
                    id: 4,
                    title: "Toplu Besleme Etkinliği Başarıyla Tamamlandı",
                    description: "Gönüllülerle birlikte onlarca sokak köpeğine mama ulaştırıldı.",
                    category: "Başarı",
                    publish_at: "12 Aralık 2024",
                    image: "/img/5.jpg",
                    views: 3100,
                    fullContent: "Bu hafta düzenlediğimiz toplu mama destek etkinliğinde yüzlerce dostumuza mama ulaştırdık. Besleme noktaları gezilerek mama kapları dolduruldu, su tazelendi ve yaralı hayvanlar tespit edildi.\n\nDestek veren herkese teşekkür ederiz. Yeni etkinlik tarihleri yakında paylaşılacaktır."
                }
            ];
            
            const announcements = data.length > 0 ? data : sampleAnnouncements;
            %>
            
            <% announcements.forEach(item=>{ %>
                <div class="col-lg-6 col-12">
                    <div class="announcement-card-new section-card overflow-hidden">
                        <div class="announcement-image">
                            <% if (item.image) { %>
                                <img src="<%= item.image %>" alt="<%= item.title %>" class="img-fluid">
                            <% } else { %>
                                <div class="announcement-image-placeholder">
                                    <img src="https://picsum.photos/seed/cat-dog-street-<%= item.id || Math.random() %>/400/200.jpg" alt="Sokak Hayvanları" class="img-fluid">
                                </div>
                            <% } %>
                        </div>
                        <div class="announcement-content p-4">
                            <div class="announcement-meta mb-3">
                                <span class="announcement-category badge"><%= item.category || 'Genel' %></span>
                                <span class="announcement-date"><%= item.publish_at %></span>
                            </div>
                            <h3 class="announcement-title mb-3">
                                <a href="/announcements/<%= item.slug || item.id %>" class="text-decoration-none"><%= item.title %></a>
                            </h3>
                            <p class="announcement-excerpt mb-3">
                                <%= item.description ? item.description.substring(0, 150) + '...' : '' %>
                            </p>
                            <div class="announcement-footer d-flex justify-content-between align-items-center">
                                <a href="/announcements/<%= item.slug || item.id %>" class="btn btn-main">
                                    Devamını Oku <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                                <div class="announcement-stats">
                                    <span class="stat-item">
                                        <i class="bi bi-eye"></i> <%= item.views || 0 %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <style>
        .announcements-page {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
        }

        .announcements-hero {
            background: linear-gradient(135deg, var(--pet-red) 0%, #0b2d52 100%);
            color: white;
            border-radius: 20px;
            position: relative;
            overflow: hidden;
        }

        .announcements-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: float 20s ease-in-out infinite;
        }

        .announcement-card-new {
            border-radius: 16px;
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.07);
        }

        .announcement-card-new:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(26, 107, 181, 0.15);
        }

        .announcement-image {
            height: 200px;
            overflow: hidden;
            position: relative;
        }

        .announcement-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .announcement-card-new:hover .announcement-image img {
            transform: scale(1.05);
        }

        .announcement-image-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--pet-red);
            font-size: 3rem;
        }

        .announcement-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .announcement-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .announcement-category {
            background: var(--pet-red);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .announcement-date {
            color: #6c757d;
            font-size: 0.875rem;
        }

        .announcement-title {
            font-size: 1.25rem;
            font-weight: 700;
            line-height: 1.4;
        }

        .announcement-title a {
            color: var(--pet-ink);
            transition: color 0.3s ease;
        }

        .announcement-title a:hover {
            color: var(--pet-red);
        }

        .announcement-excerpt {
            color: #6c757d;
            line-height: 1.6;
            flex: 1;
        }

        .announcement-footer {
            margin-top: auto;
            padding-top: 1rem;
        }

        .announcement-stats {
            display: flex;
            gap: 1rem;
        }

        .stat-item {
            color: #6c757d;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(30px, -30px) rotate(180deg); }
        }

        @media (max-width: 768px) {
            .announcement-card-new {
                margin-bottom: 1rem;
            }
            
            .announcement-image {
                height: 150px;
            }
        }
    </style>
    <%- include('../partials/script') %>
</body>
</html>
