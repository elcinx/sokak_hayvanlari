<div class="admin-topbar px-4 py-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h4 mb-0"><%= contentTitle %></h1>
        <% if (contentDesc) { %>
            <div class="text-muted small"><%= contentDesc %></div>
        <% } %>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge badge-soft"><%= role || 'user' %></span>
        <span class="fw-semibold"><%= fullname || '' %></span>
        <a href="/auth/signout" class="btn btn-outline-red btn-sm">Cikis</a>
    </div>
</div>
