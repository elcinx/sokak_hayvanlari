<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme">
    <%- include('../partials/navbar') %>
    <div class="container py-5">
        <div class="login-card p-4">
            <div class="text-center mb-3">
                <div class="display-6">??</div>
                <h2 class="mb-1">Giris Yap</h2>
                <p class="text-muted">Yonetim ve profil islemleri icin giris yapin.</p>
            </div>
            <form action="" method="post">
                <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                <% if (typeof(message)!="undefined") { %>
                    <div class="alert alert-<%=message.class%>"><%=message.text %></div>
                <% } %>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" type="email" class="form-control" value="<%=authinfo.email %>">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Sifre</label>
                    <input name="password" type="password" class="form-control" value="<%=authinfo.password %>">
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="exampleCheck1" value="1" name="cbhatirla" <%=authinfo.password?"checked":null %>>
                    <label class="form-check-label" for="exampleCheck1">Beni hatirla</label>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-pet" id="btnkaydet">Oturum Ac</button>
                    <a href="reset-password" class="btn btn-outline-danger">Parolayi Sifirla</a>
                </div>
            </form>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
