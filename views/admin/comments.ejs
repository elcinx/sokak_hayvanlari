<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'comments' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Yorum moderasyonu ve denetim' }) %>
            <div class="container-fluid py-4">
                <div class="admin-card p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Yorumlar</h5>
                        <span class="text-muted small">Toplam: <%= comments.length %></span>
                    </div>
                    <div class="admin-simple-list">
                        <% comments.forEach(c=>{ %>
                            <div class="admin-item">
                                <div class="admin-item-head">
                                    <div>
                                        <div class="fw-semibold"><%= c.name %></div>
                                        <div class="admin-meta">
                                            <a href="/feeds/<%= c.feed_id %>" target="_blank">Feed <%= c.feed_id %></a>
                                            <span class="text-muted">- <%= c.created_at %></span>
                                        </div>
                                    </div>
                                    <a href="/admin/comments/delete/<%= c.id %>" class="btn btn-sm btn-outline-danger">Sil</a>
                                </div>
                                <div class="admin-item-body">
                                    <%= c.content %>
                                </div>
                            </div>
                        <% }) %>
                        <% if (comments.length === 0) { %>
                            <div class="text-center text-muted py-4">Henuz yorum yok.</div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
