<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'dashboard' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Genel durum ve son aktiviteler' }) %>
            <div class="container-fluid py-4">
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card p-3 h-100">
                            <div class="small text-muted">Toplam Besleme</div>
                            <div class="h3 mb-0 fw-bold"><%= stats.totalFeeds %></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card p-3 h-100">
                            <div class="small text-muted">Bugun Besleme</div>
                            <div class="h3 mb-0 fw-bold"><%= stats.todayFeeds %></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card p-3 h-100">
                            <div class="small text-muted">Aktif Nokta</div>
                            <div class="h3 mb-0 fw-bold"><%= stats.activePoints %></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card p-3 h-100">
                            <div class="small text-muted">Online</div>
                            <div class="h3 mb-0 fw-bold"><%= stats.online %></div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="admin-card p-3 h-100">
                            <h5 class="mb-3">Haftalik Top 5</h5>
                            <ul class="list-group list-group-flush">
                                <% weekly.forEach((w,idx)=>{ %>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span><%= idx+1 %>. <%= w.name %></span>
                                        <span class="badge badge-soft"><%= w.points %></span>
                                    </li>
                                <% }) %>
                                <% if (weekly.length===0){ %>
                                    <li class="list-group-item">Veri yok</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="admin-card p-3 h-100">
                            <h5 class="mb-3">Son 10 Besleme</h5>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Foto</th>
                                            <th>Kullanici</th>
                                            <th>Tarih</th>
                                            <th>Konum</th>
                                            <th>Puan</th>
                                            <th>Y/L</th>
                                            <th>Islem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% feeds.forEach(f=>{ %>
                                            <tr>
                                                <td style="width:70px">
                                                    <% if(f.photo_url){ %>
                                                        <img src="<%= f.photo_url %>" style="width:60px;height:60px;object-fit:cover;" class="rounded">
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <td><%= f.name || 'Kullanici' %></td>
                                                <td><%= f.created_at %></td>
                                                <td><%= f.lat %>, <%= f.lng %></td>
                                                <td><%= f.points %></td>
                                                <td><%= f.comment_count %>/<%= f.like_count %></td>
                                                <td class="text-nowrap">
                                                    <a href="/feeds/<%= f.id %>" class="btn btn-sm btn-outline-primary">Detay</a>
                                                    <a href="/admin/feeds/delete/<%= f.id %>" class="btn btn-sm btn-outline-danger">Sil</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
