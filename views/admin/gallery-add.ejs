<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'gallery' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Yeni galeri gorseli ekle' }) %>
            <div class="container-fluid py-4">
                <% if (typeof flash !== "undefined" && flash && flash.text) { %>
                    <div class="alert alert-<%= flash.type || 'info' %>"><%= flash.text %></div>
                <% } %>
                <div class="admin-card p-4">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                        <div class="mb-3">
                            <label for="title" class="form-label">Baslik</label>
                            <input type="text" class="form-control" id="title" name="title" placeholder="Baslik">
                        </div>
                        <div class="mb-3">
                            <label for="image" class="form-label">Resim</label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-pet">Kaydet</button>
                            <a href="/admin/gallery/list" class="btn btn-outline-secondary">Listeye don</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
