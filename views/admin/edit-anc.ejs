<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'announcements' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Duyuru guncelle' }) %>
            <div class="container-fluid py-4">
                <div class="admin-card p-4">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                        <input type="hidden" name="noticeid" value="<%= oldData.noticeid %>">
                        <div class="mb-3">
                            <label for="title" class="form-label">Baslik</label>
                            <input type="text" class="form-control" id="title" name="title" value="<%= oldData.title %>">
                        </div>
                        <div class="mb-3">
                            <label for="explain" class="form-label">Aciklama</label>
                            <textarea name="explain" id="explain"><%- oldData.exp %></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Duyuru Fotografi</label>
                            <% if (oldData.image_url) { %>
                                <div class="mb-2">
                                    <img src="<%= oldData.image_url %>" alt="<%= oldData.title %>" class="img-fluid rounded" style="max-height:160px;">
                                </div>
                            <% } %>
                            <input type="file" class="form-control" name="image" accept="image/*">
                        </div>
                        <div class="mb-3">
                            <label for="category" class="form-label">Kategori</label>
                            <input type="text" class="form-control" id="category" name="category" value="<%= oldData.category %>">
                        </div>
                        <div class="mb-3">
                            <label for="publish_at" class="form-label">Yayin Tarihi</label>
                            <input type="datetime-local" class="form-control" id="publish_at" name="publish_at" value="<%= oldData.publish_at %>">
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="gridCheck1" name="isActive" <%= oldData.is_active ? 'checked' : '' %>>
                            <label class="form-check-label" for="gridCheck1">Yayinda</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Olusturan Kullanici</label>
                            <select class="form-select" name="user">
                                <% users.forEach(u=>{ %>
                                    <option value="<%= u.userid %>" <%= u.userid === oldData.created_by ? 'selected' : '' %>><%= u.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-pet">Guncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script.ejs') %>
    <script src="/static/js/admin-anc-form.js"></script>
</body>
</html>
