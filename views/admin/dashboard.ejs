<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'dashboard' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Genel durum ve son aktiviteler' }) %>
            <div class="container-fluid py-4">
                <!-- Admin Hero Banner -->
                <section class="admin-hero rounded-4 p-4 p-md-5 mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="eyebrow text-uppercase">Yönetim Paneli</div>
                            <h2 class="hero-heading mb-2"><%= contentTitle || 'Kontrol Paneli' %></h2>
                            <p class="mb-0 hero-sub">Sistemin genel durumunu takip edin, hızlı işlemlerle yönetimi kolaylaştırın.</p>
                        </div>
                        <div class="quick-stats d-flex gap-3">
                            <div class="qs-pill">
                                <i class="bi bi-people"></i>
                                Online: <strong><%= stats.online %></strong>
                            </div>
                            <div class="qs-pill">
                                <i class="bi bi-geo-alt"></i>
                                Nokta: <strong><%= stats.activePoints %></strong>
                            </div>
                            <div class="qs-pill">
                                <i class="bi bi-bowl-rice"></i>
                                Besleme: <strong><%= stats.totalFeeds %></strong>
                            </div>
                        </div>
                    </div>
                    <div class="quick-actions mt-3">
                        <a href="/admin/add/anc" class="btn btn-light btn-action"><i class="bi bi-megaphone me-2"></i>Yeni Duyuru</a>
                        <a href="/admin/gallery" class="btn btn-light btn-action"><i class="bi bi-images me-2"></i>Galeri Yönetimi</a>
                        <a href="/admin/feeds" class="btn btn-light btn-action"><i class="bi bi-list-ul me-2"></i>Beslemeler</a>
                        <a href="/admin/users" class="btn btn-light btn-action"><i class="bi bi-people me-2"></i>Kullanıcılar</a>
                    </div>
                </section>
                <!-- Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card stat-card-enhanced p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-icon-enhanced bg-primary bg-opacity-10">
                                    <i class="bi bi-bowl-rice text-primary fs-5"></i>
                                </div>
                                <span class="badge bg-primary bg-opacity-20 text-primary small">+12%</span>
                            </div>
                            <div class="small text-muted mb-1">Toplam Besleme</div>
                            <div class="h3 mb-0 fw-bold text-primary"><%= stats.totalFeeds %></div>
                            <div class="small text-success mt-2">
                                <i class="bi bi-arrow-up"></i> Bu ay artış
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card stat-card-enhanced p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-icon-enhanced bg-success bg-opacity-10">
                                    <i class="bi bi-calendar-check text-success fs-5"></i>
                                </div>
                                <span class="badge bg-success bg-opacity-20 text-success small">Bugün</span>
                            </div>
                            <div class="small text-muted mb-1">Bugün Besleme</div>
                            <div class="h3 mb-0 fw-bold text-success"><%= stats.todayFeeds %></div>
                            <div class="small text-muted mt-2">Aktif kullanıcılar</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card stat-card-enhanced p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-icon-enhanced bg-warning bg-opacity-10">
                                    <i class="bi bi-geo-alt text-warning fs-5"></i>
                                </div>
                                <span class="badge bg-warning bg-opacity-20 text-warning small">Çevrimiçi</span>
                            </div>
                            <div class="small text-muted mb-1">Aktif Nokta</div>
                            <div class="h3 mb-0 fw-bold text-warning"><%= stats.activePoints %></div>
                            <div class="small text-muted mt-2">Besleme noktaları</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="admin-card stat-card-enhanced p-4 h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-icon-enhanced bg-info bg-opacity-10">
                                    <i class="bi bi-people text-info fs-5"></i>
                                </div>
                                <span class="badge bg-info bg-opacity-20 text-info small">Canlı</span>
                            </div>
                            <div class="small text-muted mb-1">Online</div>
                            <div class="h3 mb-0 fw-bold text-info"><%= stats.online %></div>
                            <div class="small text-muted mt-2">Kullanıcı çevrimiçi</div>
                        </div>
                    </div>
                </div>
                
                <!-- Content Section -->
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="admin-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-trophy text-warning me-2"></i>Haftalık Top 5
                                </h5>
                                <span class="badge bg-warning bg-opacity-20 text-warning">
                                    <i class="bi bi-star-fill me-1"></i>Liderler
                                </span>
                            </div>
                            <div class="leaderboard-list">
                                <% weekly.forEach((w,idx)=>{ %>
                                    <div class="leaderboard-item d-flex align-items-center p-3 rounded mb-2 bg-light bg-opacity-50">
                                        <div class="rank-badge-enhanced me-3 <%= idx === 0 ? 'bg-warning text-dark' : idx === 1 ? 'bg-secondary text-white' : idx === 2 ? 'bg-danger text-white' : 'bg-primary text-white' %>">
                                            <%= idx+1 %>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold"><%= w.name %></div>
                                            <div class="small text-muted">Toplam puan</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="h5 mb-0 fw-bold text-primary"><%= w.points %></div>
                                            <div class="small text-success">
                                                <i class="bi bi-graph-up"></i> +<%= Math.floor(Math.random() * 20) + 5 %>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                                <% if (weekly.length===0){ %>
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Bu hafta veri bulunmuyor
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="admin-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-clock-history text-primary me-2"></i>Son 10 Besleme
                                </h5>
                                <a href="/admin/feeds" class="btn btn-sm btn-outline-primary">
                                    Tümünü Gör
                                </a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Fotoğraf</th>
                                            <th>Kullanıcı</th>
                                            <th>Tarih</th>
                                            <th>Konum</th>
                                            <th>Puan</th>
                                            <th>Etkileşim</th>
                                            <th>İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% feeds.forEach(f=>{ %>
                                            <tr class="feed-row">
                                                <td>
                                                    <% if(f.photo_url){ %>
                                                        <div class="feed-photo">
                                                            <img src="<%= f.photo_url %>" class="rounded" alt="Besleme fotoğrafı">
                                                        </div>
                                                    <% } else { %>
                                                        <div class="no-photo bg-light rounded d-flex align-items-center justify-content-center">
                                                            <i class="bi bi-image text-muted"></i>
                                                        </div>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2">
                                                            <i class="bi bi-person text-primary"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold"><%= f.name || 'Kullanıcı' %></div>
                                                            <div class="small text-muted">ID: <%= f.userid || 'N/A' %></div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="text-muted small"><%= f.created_at %></div>
                                                </td>
                                                <td>
                                                    <div class="location-info">
                                                        <div class="small text-muted">
                                                            <i class="bi bi-geo-alt me-1"></i>
                                                            <%= f.lat ? f.lat.substring(0, 6) : '0' %>, <%= f.lng ? f.lng.substring(0, 6) : '0' %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-success bg-opacity-20 text-success fw-semibold">
                                                        <%= f.points %> puan
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="interaction-stats">
                                                        <div class="d-flex gap-2">
                                                            <span class="badge bg-primary bg-opacity-20 text-primary">
                                                                <i class="bi bi-chat"></i> <%= f.comment_count || 0 %>
                                                            </span>
                                                            <span class="badge bg-danger bg-opacity-20 text-danger">
                                                                <i class="bi bi-heart"></i> <%= f.like_count || 0 %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-nowrap">
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/feeds/<%= f.id %>" class="btn btn-outline-primary" title="Detay">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="/admin/feeds/delete/<%= f.id %>" class="btn btn-outline-danger" title="Sil" 
                                                           onclick="return confirm('Bu besleme kaydını silmek istediğinizden emin misiniz?')">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <% if (feeds.length === 0) { %>
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Henüz besleme kaydı bulunmuyor
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        /* Admin Hero */
        .admin-hero {
            background: radial-gradient(1200px 400px at -10% -20%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0) 60%),
                        linear-gradient(135deg, var(--pet-red), #0b2d52);
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .admin-hero::after{
            content:"";
            position:absolute; inset:-30%;
            background: radial-gradient(600px 220px at 120% 10%, rgba(255,255,255,0.18), transparent 70%);
            pointer-events:none;
        }
        .admin-hero .eyebrow{letter-spacing:.08em; font-size:.8rem; opacity:.85}
        .admin-hero .hero-heading{font-weight:800}
        .admin-hero .hero-sub{opacity:.9}
        .quick-stats .qs-pill{
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.18);
            padding: .5rem .75rem; border-radius: 999px; display:flex; align-items:center; gap:.4rem;
        }
        .quick-actions .btn-action{
            background: rgba(255,255,255,.9);
            border: 1px solid rgba(0,0,0,.06);
            box-shadow: 0 6px 18px rgba(0,0,0,.06);
            margin-right: .5rem; margin-bottom:.5rem;
        }
        .quick-actions .btn-action:hover{transform: translateY(-2px); box-shadow:0 10px 24px rgba(0,0,0,.08)}
        .stat-card-enhanced {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            border: 1px solid rgba(26, 107, 181, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .stat-card-enhanced::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--pet-red), #0b2d52);
        }
        
        .stat-card-enhanced:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(26, 107, 181, 0.15);
        }
        
        .stat-icon-enhanced {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        
        .stat-card-enhanced:hover .stat-icon-enhanced {
            transform: scale(1.1);
        }
        
        .leaderboard-item {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }
        
        .leaderboard-item:hover {
            background: rgba(26, 107, 181, 0.05) !important;
            border-left-color: var(--pet-red);
            transform: translateX(4px);
        }
        
        .rank-badge-enhanced {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.875rem;
        }
        
        .feed-photo img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        
        .feed-photo:hover img {
            transform: scale(1.1);
        }
        
        .no-photo {
            width: 50px;
            height: 50px;
        }
        
        .avatar-sm {
            width: 32px;
            height: 32px;
        }
        
        .feed-row {
            transition: background-color 0.3s ease;
        }
        
        .feed-row:hover {
            background-color: rgba(26, 107, 181, 0.03) !important;
        }
        
        .interaction-stats .badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }
        
        .table thead th {
            background: rgba(26, 107, 181, 0.05);
            border-bottom: 2px solid rgba(26, 107, 181, 0.1);
            font-weight: 600;
            color: var(--pet-ink);
        }
        
        @media (max-width: 768px) {
            .stat-card-enhanced {
                margin-bottom: 1rem;
            }
            
            .interaction-stats .badge {
                font-size: 0.7rem;
                padding: 0.2rem 0.4rem;
            }
        }
    </style>
    
    <%- include('../partials/script') %>
</body>
</html>
