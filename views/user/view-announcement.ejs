<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme">
    <%- include('../partials/navbar') %>
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="section-card p-4">
                    <% const imageBySlug = { 'resim-1': '/static/img/3.jpg', 'resim-2': '/static/img/4.jpg', 'resim-3': '/static/img/5.jpg', 'resim-4': '/static/img/2.jpg' }; %>
                    <% const imageSrc = viewData.image || imageBySlug[viewData.slug] || null; %>
                    <% if (imageSrc) { %>
                        <div class="mb-3">
                            <img src="<%= imageSrc %>" alt="<%= viewData.title %>" class="img-fluid rounded">
                        </div>
                    <% } %>
                    <h1 class="mb-3"><%= viewData.title %></h1>
                    <% if (viewData.description) { %>
                        <p class="text-muted"><%= viewData.description %></p>
                    <% } %>
                    <div class="mt-3" style="white-space: pre-line;">
                        <%- viewData.fullContent || viewData.exp || "" %>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <%- include('./announcements-sidebar') %>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
