<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <div id="page-content-wrapper">
                <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                    <div class="container-fluid">
                        <button class="btn btn-primary" id="sidebarToggle">Menü</button>
                        <%- include('../partials/right-top-menu') %>
                    </div>
                </nav>
                <div class="container-fluid">
                    <h1 class="mt-3"><%= contentTitle %></h1>
                    <div class="row">
                        <div class="col-lg-7 bg-light ms-2 border border-info p-3">
                            <h5>Rozetler</h5>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Kod</th>
                                        <th>Ad</th>
                                        <th>Açıklama</th>
                                        <th>Kullanıcı Sayısı</th>
                                        <th>Aktif</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% badges.forEach(b=>{ %>
                                        <tr>
                                            <td><%= b.code %></td>
                                            <td><%= b.name %></td>
                                            <td><%= b.description %></td>
                                            <td><%= b.user_count || 0 %></td>
                                            <td><input type="checkbox" disabled <%= b.is_active ? "checked":"" %> /></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-lg-4 bg-light ms-2 border border-info p-3">
                            <h5>Son 20 Rozet Kazanan</h5>
                            <ul class="list-group">
                                <% recent.forEach(r=>{ %>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span><strong><%= r.user_name %></strong> - <%= r.badge_name %></span>
                                        <small><%= r.earned_at %></small>
                                    </li>
                                <% }) %>
                                <% if(recent.length===0){ %>
                                    <li class="list-group-item">Henüz veri yok</li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../partials/script') %>
    </body>
</html>
