<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
<body class="pet-theme admin-theme">
    <div class="admin-wrapper">
        <%- include('./partials/sidebar', { activePage: 'feeds' }) %>
        <div class="admin-main">
            <%- include('./partials/topbar', { contentTitle, contentDesc: 'Besleme kayitlari ve detaylar' }) %>
            <div class="container-fluid py-4">
                <div class="admin-card p-3">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Foto</th>
                                    <th>Kullanici</th>
                                    <th>Tarih</th>
                                    <th>Konum</th>
                                    <th>Not</th>
                                    <th>Y/L</th>
                                    <th>Puan</th>
                                    <th>Islem</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% feeds.forEach(f=>{ %>
                                    <tr>
                                        <td style="width:70px">
                                            <% if(f.photo_url){ %>
                                                <img src="<%= f.photo_url %>" style="width:60px;height:60px;object-fit:cover;" class="rounded">
                                            <% } else { %>-<% } %>
                                        </td>
                                        <td><%= f.name || 'Kullanici' %></td>
                                        <td><%= f.created_at %></td>
                                        <td><%= f.lat %>, <%= f.lng %></td>
                                        <td><%= (f.note || '').slice(0,50) %></td>
                                        <td><%= f.comment_count %>/<%= f.like_count %></td>
                                        <td><%= f.points %></td>
                                        <td class="text-nowrap">
                                            <a href="/feeds/<%= f.id %>" class="btn btn-sm btn-outline-primary">Detay</a>
                                            <a href="/admin/feeds/delete/<%= f.id %>" class="btn btn-sm btn-outline-danger">Sil</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <nav aria-label="page" class="mt-3">
                        <ul class="pagination mb-0">
                            <% for(let i=1;i<=totalPages;i++){ %>
                                <li class="page-item <%= i===page?'active':'' %>">
                                    <a class="page-link" href="/admin/feeds?page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/script') %>
</body>
</html>
