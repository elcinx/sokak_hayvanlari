<!DOCTYPE html>
<html lang="tr">
<%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <div id="page-content-wrapper">
                <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                    <div class="container-fluid">
                        <button class="btn btn-primary" id="sidebarToggle">Menü</button>
                        <%- include('../partials/right-top-menu') %>
                    </div>
                </nav>
                <div class="container-fluid">
                    <h1 class="mt-3"><%= contentTitle %></h1>
                    <% if (typeof flash !== "undefined" && flash && flash.text) { %>
                        <div class="alert alert-<%= flash.type || 'info' %>"><%= flash.text %></div>
                    <% } %>
                    <div class="row">
                        <div class="col-sm-8 bg-light ms-2 border border-info p-3">
                            <form method="post" enctype="multipart/form-data">
                                <input type="hidden" name="_csrf" value="<%=csrfToken %>">
                                <div class="form-group row mb-3 mt-3">
                                    <label for="title" class="col-sm-3 col-form-label">Başlık</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="title" name="title" placeholder="Başlık">
                                    </div>
                                </div>
                                <div class="form-group row mb-3">
                                    <label for="image" class="col-sm-3 col-form-label">Resim</label>
                                    <div class="col-sm-9">
                                        <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                                    </div>
                                </div>
                                <div class="form-group row justify-content-end mb-3">
                                    <div class="col-sm-9">
                                        <button type="submit" class="btn btn-primary">Kaydet</button>
                                        <a href="/admin/gallery" class="btn btn-secondary">Listeye dön</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../partials/script') %>
    </body>
</html>
