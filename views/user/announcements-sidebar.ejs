<div class="section-card p-3">
    <h5 class="mb-3">Duyurular</h5>
    <div class="list-group list-group-flush">
        <% data.slice(0,5).forEach((element,index) => { %>
            <a href="/announcements/<%=element.slug || element.id %>" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                <img src="<%= element.image || '/static/img/2.jpg' %>" alt="<%= element.title %>" class="rounded" style="width:48px;height:48px;object-fit:cover;">
                <strong><%= element.title %></strong>
            </a>
        <% }) %>
    </div>
</div>
